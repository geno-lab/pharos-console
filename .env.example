# Frontend build-time env. Copy to .env.local for local overrides.

# Absolute or relative path the built API calls go to. Leave unset in dev (Vite proxy handles it).
# For the mini_m2 subpath deploy, set to /pharos/api
# VITE_API_BASE=/pharos/api

# Absolute URL or relative path for the WebSocket.
# For mini_m2 subpath deploy, set to /pharos/ws
# VITE_WS_URL=/pharos/ws

# Subpath the bundle is served from. Needed at build time only.
# BASE_PATH=/pharos/
